{
  "name": "@local/dsh-render",
  "version": "0.2.5",
  "private": true,
  "description": "Rich rendering for DeepSeek Harness: Mermaid diagrams, ECharts charts, and CSV tables rendered from fenced code blocks, with a Render settings page.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "vendor/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CONTRACT.md",
    "docs/DESIGN.md",
    "docs/VENDOR.md",
    "docs/harness-client.patch",
    "scripts/sync-vendor.mjs",
    "test/*.js"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js client.js lib/*.js",
    "sync:vendor": "node scripts/sync-vendor.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "license": "MIT"
}
